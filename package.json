{
	"name": "nosedive-core",
	"version": "2026.10.11-1791741249908",
	"private": true,
	"description": "nosedive's core: the library and the free commands, built into one minified bundle the nosedive package ships.",
	"license": "UNLICENSED",
	"author": "Dan Stace <dstace@gmail.com>",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"commands:identifiers": "node scripts/command-identifiers.mjs",
		"build": "node scripts/build-bundle.mjs",
		"format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" \"package.json\" \"tsconfig.json\" \".prettierrc.json\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"package.json\" \"tsconfig.json\" \".prettierrc.json\"",
		"typecheck": "tsc",
		"check:release-surface": "node scripts/check-release-surface.mjs",
		"check:signoff": "node scripts/check-signoff.mjs",
		"test": "npm run format:check && npm run check:release-surface && node --test \"scripts/test/*.mjs\"",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"prettier": "3.9.6",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"ajv": "^8.20.0",
		"marked": "^18.0.14",
		"yaml": "^2.9.0"
	}
}
